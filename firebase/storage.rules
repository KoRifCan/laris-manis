// Vercel Blob Storage - No Firebase Storage Rules needed
// File uploads go directly to Vercel Blob via server-side API
// Client never uploads directly to storage

// If using Firebase Storage in future, rules would be:
/*
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{storeId}/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
        && (request.auth.uid == storeId 
          || request.auth.token.role in ['admin', 'super_admin'])
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
*/